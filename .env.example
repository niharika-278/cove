# Cove environment variables
# Copy to .env at the repo root for local development.
# Copy frontend vars to frontend/.env.local (see frontend/.env.local.example).

# ── Backend (persistent Node server — NOT Vercel) ─────────────────────────────
PORT=4001
NODE_ENV=development


CLIENT_ORIGIN=http://localhost:3000

# Empty room TTL (default 15 minutes)
ROOM_EMPTY_TIMEOUT_MS=900000
# How often the server scans for expired empty rooms (default 60s)
ROOM_CLEANUP_INTERVAL_MS=60000
MAX_PARTICIPANTS_PER_ROOM=4
MAX_CHAT_MESSAGES=200

# ── Frontend (Vercel / Next.js — public, baked into client bundle) ────────────
# Set these in Vercel project settings AND in frontend/.env.local for local dev.
NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001

